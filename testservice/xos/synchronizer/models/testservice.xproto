option app_label = "testservice";
option name = "testservice";

message TestserviceService (Service){
  option verbose_name = "Testservice Service";
}

message TestserviceServiceInstance (ServiceInstance){
  option owner_class_name = "TestserviceService";
  option verbose_name = "Testservice Service Instance";

  required bool sync_after_policy = 1 [default = False, null = False, db_index = False, blank = True];
  required bool sync_during_policy = 2 [default = False, null = False, db_index = False, blank = True];
  required bool policy_after_sync = 3 [default = False, null = False, db_index = False, blank = True];
  required bool policy_during_sync = 4 [default = False, null = False, db_index = False, blank = True];

  required bool update_during_sync = 5 [default = False, null = False, db_index = False, blank = True];
  required bool update_during_policy = 5 [default = False, null = False, db_index = False, blank = True];

  required int32 some_integer = 6 [default = 0];
  required int32 some_other_integer = 7 [default = 0];
}

