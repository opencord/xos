message XOSBase {
     required string created = 1 [db_index = False, null = False, content_type = "date", blank = True];
     required string updated = 2 [default = "now", null = False, db_index = False, content_type = "date", blank = False];
     optional string enacted = 3 [db_index = False, null = True, content_type = "date", blank = True];
     optional string policed = 4 [db_index = False, null = True, content_type = "date", blank = True];
     optional string backend_register = 5 [default = "{}", max_length = 1024, null = True, db_index = False, blank = False];
     required bool backend_need_delete = 6 [default = False, null = False, db_index = False, blank = True];
     required bool backend_need_reap = 7 [default = False, null = False, db_index = False, blank = True];
     required string backend_status = 8 [default = "0 - Provisioning in progress", max_length = 1024, null = False, db_index = False, blank = False];
     required bool deleted = 9 [default = False, null = False, db_index = False, blank = True];
     required bool write_protect = 10 [default = False, null = False, db_index = False, blank = True];
     required bool lazy_blocked = 11 [default = False, null = False, db_index = False, blank = True];
     required bool no_sync = 12 [default = False, null = False, db_index = False, blank = True];
     required bool no_policy = 13 [default = False, null = False, db_index = False, blank = True];
}
