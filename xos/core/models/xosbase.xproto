message XOSBase {
     required int32 id = 1 [db_index = False, null = False, blank = True];
     required string created = 2 [db_index = False, null = False, content_type = "date", blank = True];
     required string updated = 3 [default = "now()", null = False, db_index = False, content_type = "date", blank = False];
     optional string enacted = 4 [db_index = False, null = True, content_type = "date", blank = True];
     optional string policed = 5 [db_index = False, null = True, content_type = "date", blank = True];
     optional string backend_register = 6 [default = "{}", max_length = 1024, null = True, db_index = False, blank = False];
     required bool backend_need_delete = 7 [default = False, null = False, db_index = False, blank = True];
     required bool backend_need_reap = 8 [default = False, null = False, db_index = False, blank = True];
     required string backend_status = 9 [default = "0 - Provisioning in progress", max_length = 1024, null = False, db_index = False, blank = False];
     required bool deleted = 10 [default = False, null = False, db_index = False, blank = True];
     required bool write_protect = 11 [default = False, null = False, db_index = False, blank = True];
     required bool lazy_blocked = 12 [default = False, null = False, db_index = False, blank = True];
     required bool no_sync = 13 [default = False, null = False, db_index = False, blank = True];
     required bool no_policy = 14 [default = False, null = False, db_index = False, blank = True];
}
