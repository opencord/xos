# Replace the line below with the location of xosgen
XOSGEN=~/Projects/generator/xosgen

TARGET=service
DJANGO_TARGET=~/Projects/generator/targets/$(TARGET).xtarget

XPROTOS_TMP := $(shell mktemp)

xprotos = $(wildcard *.xproto)

all: models.py

models.py: $(xprotos)
	$(XOSGEN) --attic attic --input $< --target $(DJANGO_TARGET) --output $@

.PHONY: all
	
clean:
	rm -f models.py
