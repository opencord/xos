{
{%- for model in proto.messages %}
{%- if model.links %}
    "{{ model.name }}": [
        {% for l in model.links -%}
        {% if "Controller" + l.peer.name in proto.message_names -%}
        "Controller{{ l.peer.name }}",
        {% endif %}
        "{{ l.peer.name }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ],{% endif -%}
{% endfor %}
}
